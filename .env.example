# Copy to .env, edit privately, then: set -a; source .env; set +a (Linux/Bash).
# Python CLIs read the process environment; .env is not automatically loaded.
TEACHER_BASE_URL=https://openrouter.ai/api/v1
TEACHER_MODEL=cohere/north-mini-code:free
TEACHER_API_KEY=replace-with-private-openrouter-key
TEACHER_MAX_TOKENS=4096
TEACHER_TEMPERATURE=0.2
TEACHER_RETRIES=2
TEACHER_TIMEOUT=180
# Free token pricing checked 2026-10-18. GPU/validation costs are separate.
TEACHER_INPUT_PRICE_PER_MILLION=0
TEACHER_OUTPUT_PRICE_PER_MILLION=0
# For OpenRouter: require an explicit :free model and zero-price providers.
TEACHER_FREE_ONLY=1
# Shared across this process's async workers; daily quotas still apply.
TEACHER_REQUEST_INTERVAL=3.4

POSTGRES_PASSWORD=replace-with-a-long-private-password
PGVECTOR_DSN=postgresql://kernels:replace-with-a-long-private-password@127.0.0.1:5432/kernels
EMBEDDING_BASE_URL=http://127.0.0.1:8001/v1
# Replace SHA using the local service's /health model field (see docs/EMBEDDINGS.md).
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2@REPLACE_WITH_RESOLVED_SHA
EMBEDDING_DIMENSIONS=384
EMBEDDING_API_KEY=local

# Set these after SSH on Rivanna; do not paste Windows paths.
# PROJECT_DIR=/scratch/YOUR_ID/triton-kernel-lab
# TRAIN_ENV=/scratch/YOUR_ID/venvs/kernel-train
# SERVE_ENV=/scratch/YOUR_ID/venvs/kernel-serve
# SFT_DATA=/scratch/YOUR_ID/triton-kernel-lab/artifacts/sft
# RUN_OUTPUT=/scratch/YOUR_ID/runs/qwen-lora-001
# VLLM_API_KEY=generate-a-private-random-token
